# Keep the existing private .env for this database. Its SECRET_KEY is needed
# to decrypt existing protected data. These placeholders are for reference.
SECRET_KEY=keep_the_existing_private_application_secret
SESSION_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER=your_gmail_address@gmail.com
# Render Free blocks SMTP. Use an HTTPS provider there instead:
# MAIL_TRANSPORT=brevo
# BREVO_API_KEY=your_private_brevo_api_key
# BREVO_WEBHOOK_TOKEN=separate_random_bearer_secret
# MAIL_DEFAULT_SENDER=your_verified_brevo_sender_email
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_CITY=Malabon
MD57_BACKGROUND_JOBS=true
MD57_SEED_LEGACY_ACCOUNTS=false
# Optional one-day presentation history; never enable for real accuracy evidence.
MD57_DEMO_HISTORY=false
MD57_HOST=127.0.0.1
MD57_PORT=5000
MD57_BACKUP_INTERVAL_HOURS=24
MD57_BACKUP_KEEP=14
# Configure these for your actual public HTTPS host:
# PUBLIC_BASE_URL=https://your-public-host
# MD57_TRUSTED_PROXY=127.0.0.1
# SESSION_COOKIE_SECURE=true
# Asia/Manila is enforced by the application; host TZ is not required.
# MD57_ENFORCE_CANONICAL=true
# Optional private absolute paths. Defaults use this deployment folder:
# MD57_DATA_DIR=/var/data/md57
# MD57_DB_FILE=/private-data/md57_carwash.db
# MD57_ACTIVITY_LOG=/private-data/system_activity.log
# MD57_BACKUP_DIR=/private-data/backups
# MD57_EMPLOYEE_TRANSFER_KEY=separate_private_transfer_key

# Vercel project build variable (set in Vercel, not read from this file):
# MD57_BACKEND_ORIGIN=https://your-persistent-flask-host.example.com
# See docs/VERCEL.md. SQLite and background workers stay on that host.
